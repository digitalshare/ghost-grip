# You.com — grounding (search + contents). Header: X-API-Key
YDC_API_KEY=
# Parasail — inference, schema JSON, embeddings
PARASAIL_API_KEY=
PARASAIL_MODEL=parasail-deepseek-v41-flash
PARASAIL_EMBED_MODEL=parasail-bge-m3
# One — real actions (Gmail call sheet, Calendar shoot block, Discord)
ONE_SECRET=
ONE_CONNECTION_KEYS=
CALL_SHEET_TO=
DISCORD_CHANNEL_ID=
TEAM_HANDLE=team-ghost-grip
PARASAIL_THINKING=off
# Directory of a Node >= 22.23.4 for One (auto-detects Homebrew node@24)
ONE_NODE_DIR=
SLACK_CHANNEL=
